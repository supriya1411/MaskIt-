# Database Configuration (PostgreSQL in production, SQLite supported for testing)
DATABASE_URL=postgresql://maskit_user:maskit_password@localhost:5432/maskit_db

# Redis Configuration (Used for token blacklist, rate-limiting, and Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Machine Learning Anomaly Detection Model (Optional path to trained model file)
MODEL_PATH=

# Demo Mode (false = purely real data, true = allows explicitly tagged source='DEMO' fixtures)
DEMO_MODE=false

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*"]
